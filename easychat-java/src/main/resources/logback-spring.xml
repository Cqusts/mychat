<?xml version="1.0" encoding="UTF-8" ?>
<configuration scan="true" scanPeriod="10 minutes">
    <!-- 控制台输出。
         原来这里用的是不带charset的layout，会退化成JVM默认字符集，
         在中文Windows控制台(GBK)下看到的就是一片乱码，日志根本没法读。
         默认按UTF-8输出，配合启动前的 chcp 65001；
         如果不想改控制台代码页，用 -DLOG_CONSOLE_CHARSET=GBK 启动即可。 -->
    <appender name="stdot" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>${LOG_CONSOLE_CHARSET:-UTF-8}</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss,GMT+8} [%p][%c][%M][%L]-> %m%n</pattern>
        </encoder>
    </appender>

    <springProperty scope="context" name="log.path" source="project.folder"/>
    <springProperty scope="context" name="log.root.level" source="log.root.level" defaultValue="info"/>
    <springProperty scope="context" name="log.app.level" source="log.app.level" defaultValue="info"/>

    <property name="LOG_FOLDER" value="logs"/>
    <property name="LOG_FILE_NAME" value="easychat.log"/>

    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/${LOG_FOLDER}/${LOG_FILE_NAME}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <FileNamePattern>${log.path}/${LOG_FOLDER}/${LOG_FILE_NAME}.%d{yyyyMMdd}.%i</FileNamePattern>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
            <TimeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <MaxFileSize>20MB</MaxFileSize>
            </TimeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>utf-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss,GMT+8} [%p][%c][%M][%L]-> %m%n</pattern>
        </encoder>
        <append>false</append>
        <prudent>false</prudent>
    </appender>

    <logger name="org.springframework.boot.autoconfigure.logging.ConditionEvaluationReportLoggingListener"
            level="error"></logger>
    <logger name="org.redisson.connection.DNSMonitor" level="error"></logger>
    <logger name="com.zaxxer.hikari" level="info"></logger>
    <logger name="io.lettuce.core" level="info"></logger>
    <logger name="org.springframework.data.redis" level="info"></logger>

    <!-- 项目自己的日志单独给一个级别，MyBatis的SQL也走这个包名(com.easychat.mappers.*)，
         所以把root压到info之后SQL照样看得见 -->
    <logger name="com.easychat" level="${log.app.level}"></logger>

    <!-- 下面几个是接大模型之后最吵的。Spring AI走的是WebClient，
         DEBUG级别会把每一个SSE分片、每一次编解码、每一轮工具调用的入参出参都打出来，
         一次流式回复就是几百行，控制台完全没法看。
         真要排查大模型链路的问题时，临时把对应这行删掉即可 -->
    <logger name="org.springframework.ai" level="info"></logger>
    <logger name="org.springframework.web.reactive.function.client" level="info"></logger>
    <logger name="org.springframework.core.codec" level="info"></logger>
    <logger name="org.springframework.http.codec" level="info"></logger>
    <logger name="reactor.netty" level="info"></logger>

    <root level="${log.root.level}">
        <appender-ref ref="stdot"/>
        <appender-ref ref="file"/>
    </root>

</configuration>